{
  "name": "vista",
  "version": "0.1.0",
  "private": true,
  "description": "Vista — unified TV/movies library manager, indexer, downloader, and request platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vista/web dev",
    "build": "pnpm --filter @vista/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @vista/web prisma generate",
    "db:push": "pnpm --filter @vista/web prisma db push"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
